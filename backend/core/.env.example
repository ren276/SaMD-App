# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Startup validation refuses to boot when ENVIRONMENT is not "dev" and any secret below is
# missing, too short, or still equal to its CHANGE_ME placeholder. A production service that
# starts with a default signing key is worse than one that does not start.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# dev | staging | prod. Mirrors the Android product flavor of the same name.
ENVIRONMENT=dev

# Rejects any request arriving without X-Forwarded-Proto: https. Must be true outside dev, so a
# misconfigured proxy fails loudly instead of serving PHI in the clear.
REQUIRE_HTTPS=false

# Free-form build marker surfaced by GET /health. CI sets it to the commit SHA.
GIT_SHA=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Must use the postgresql+asyncpg:// scheme. Add ?ssl=require outside dev.
DATABASE_URL=postgresql+asyncpg://samd:samd_dev_only@localhost:5432/samd

# Used only by docker-compose to seed the postgres container.
POSTGRES_PASSWORD=samd_dev_only

# ---------------------------------------------------------------------------
# Secrets. Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
# HS256 signing key for access and refresh tokens. 32 characters minimum.
JWT_SECRET_KEY=CHANGE_ME_dev_only_jwt_secret_key_min_32_chars

# pgcrypto symmetric key for the encrypted patient identity columns (Phase 2).
PHI_ENCRYPTION_KEY=CHANGE_ME_dev_only_phi_encryption_key_min_32

# HMAC key for the searchable blind indexes on abha_number and mobile_number (Phase 2).
BLIND_INDEX_KEY=CHANGE_ME_dev_only_blind_index_key_min_32_chars

# HMAC key for the kernel case-token pseudonym (Phase 3, decision D-7).
CASE_TOKEN_KEY=CHANGE_ME_dev_only_case_token_key_min_32_chars

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# Login throttling. Counters live on user_accounts, not Redis.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Kernel (Phase 3). The XGBoost FastAPI server.
# Backend /api/v1/assess   forwards to <KERNEL_BASE_URL>/v1/assess
# Backend /api/v1/evaluate forwards to <KERNEL_BASE_URL>/api/v1/evaluate
# ---------------------------------------------------------------------------
KERNEL_BASE_URL=http://10.16.4.182:8000
# Separate connect and read timeouts: a hung TCP connect and a slow model are different failures.
KERNEL_CONNECT_TIMEOUT_SECONDS=5
# Matches the Android app's existing OkHttp read timeout (di/NetworkModule.kt).
KERNEL_READ_TIMEOUT_SECONDS=30
# Circuit breaker: after this many consecutive failures the circuit opens and calls fail fast
# without hitting the network. Per-process, in memory. No Redis.
KERNEL_CIRCUIT_THRESHOLD=3
KERNEL_CIRCUIT_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# ABDM / ABHA (Phase 5). See "ABHA planning/abha-integration-plan.md".
# ABDM_MODE=stub replays recorded Postman responses through the full adapter and state machine.
# Going live is a config change, not a code change.
# ---------------------------------------------------------------------------
ABDM_MODE=stub
ABDM_BASE_URL=https://abhasbx.abdm.gov.in
ABDM_CERT_URL=https://healthidsbx.abdm.gov.in/api/v1/auth/cert
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_CM_ID=sbx
ABDM_CONSENT_CODE=abha-enrollment
ABDM_CONSENT_VERSION=1.4
ABDM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Request and response bodies are never logged at any level,
# in any environment. There is no switch for that.
LOG_LEVEL=INFO
