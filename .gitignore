local.properties
agent_docs/

# Release signing keystore — never commit prod signing keys. Generate deliberately, back up
# outside git (e.g. a password manager / secrets vault), and feed CI via KEYSTORE_PATH.
*.jks
*.keystore

# --- Doc category boundaries ---
# docs/          → tracked, IEC 62304-controlled, never gitignored
# second-brain/  → gitignored personal vault — mirrored to a separate private repo by founder
second-brain/
.obsidian
.kiro

# --- Backend (Python / FastAPI) ---
# backend/ is tracked. These are build artefacts and secrets inside it, not the source.
backend/**/.env
backend/**/__pycache__/
backend/**/*.py[cod]
backend/**/.pytest_cache/
backend/**/.mypy_cache/
backend/**/.ruff_cache/
backend/**/.venv/
backend/**/*.egg-info/
backend/**/.coverage

# --- graphify (knowledge-graph tool) ---
# Regeneratable from source; graph.json/.graphify_root bake in absolute machine paths.
graphify-out/
app/graphify-out/
backend/graphify-out/
.claude/settings.json.graphify-bak