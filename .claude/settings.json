{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "obsidian-second-brain@obsidian-second-brain": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sandesh/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sandesh/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}