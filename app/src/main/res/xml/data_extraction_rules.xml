<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The passphrase ciphertext is useless without the non-exportable Keystore key,
             which is never backed up, so keeping it in a restored backup only causes a
             MAC-verification failure against the new key. Exclude it. -->
        <exclude domain="sharedpref" path="samd_db_security_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="samd_db_security_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>