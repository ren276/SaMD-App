<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature-level: only a package signed with this app's key may repoint the backend.
         The receiver is exported because adb has to reach it, and an exported receiver that
         accepts a backend URL from anyone is a redirect of Aadhaar identity submission and OTP
         verification to a host of the sender's choosing (AUDIT5 section 3.5).
         Note the cost: `adb shell am broadcast` runs as the shell uid, which does not hold this
         permission, so tools/dev-connect.sh's hot-update broadcast now only lands on a rooted or
         userdebug device. The build-time BACKEND_BASE_URL path is unaffected. Relax to
         "signature|development" and `pm grant com.android.shell` if the broadcast is needed on a
         locked device. -->
    <permission
        android:name="com.example.samdapp.dev.permission.SET_BACKEND_URL"
        android:protectionLevel="signature" />

    <!-- BLE acquisition from kernelhub2 (PR-B addendum section 4). Declared here, dev only: staging
         and prod gain no Bluetooth permission (G-B11, G-B11b). The Nordic AAR merges BLUETOOTH
         (max 30) and BLUETOOTH_CONNECT into dev as well; this one is explicit so the app does not
         depend on the library for it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <application android:usesCleartextTraffic="true">
        <!-- LiteRT-LM GPU/NPU delegates dlopen vendor libraries; Android 12+ requires them declared.
             Optional, so a device without them still installs (on-device SLM memo 3.4;
             LiteRT-LM getting_started.md:101-109 at v0.18.0). Dev only. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <receiver
            android:name=".receiver.DevServerReceiver"
            android:exported="true"
            android:permission="com.example.samdapp.dev.permission.SET_BACKEND_URL">
            <intent-filter>
                <action android:name="com.example.samdapp.dev.SET_BACKEND_URL" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".data.vitalssource.ble.BlePrepActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
